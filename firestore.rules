rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\s]+$');
    }

    // Connection test probe
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Global application settings
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && request.resource.data is map;
    }

    // Application collections (custom username/password auth used by CBT Cerdas)
    match /users/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /guru/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /siswa/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /kelas/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /mapel/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /ujian/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /soal/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /bank_soal/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /nilai/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /progres/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /capaian_pembelajaran/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    match /log_aktivitas/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }
  }
}
